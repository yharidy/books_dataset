{
  "datasets": [
    {
      "name": "books_funnel",
      "displayName": "Gold Books (MV)",
      "queryLines": [
        "SELECT\n",
        "  `isbn`,\n",
        "  `book_title`,\n",
        "  `book_author`,\n",
        "  `publisher`,\n",
        "  `year_of_publication`,\n",
        "  `explicit_ratings`,\n",
        "  `sum_ratings`\n",
        "FROM\n",
        "  gold.books_rating_stats\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      `year_of_publication` IS NOT NULL\n",
        "      AND `year_of_publication` >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      `year_of_publication` IS NOT NULL\n",
        "      AND `year_of_publication` <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )"
      ],
      "parameters": [
        {
          "displayName": "Publication Year Range",
          "keyword": "pub_year_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "1995-01-01"
              },
              "max": {
                "value": "2004-12-31"
              }
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "Avg Explicit Rating",
          "description": "Average explicit rating (1-10): total explicit rating points / explicit rating count. Recomputes correctly at any grouping and under filters.",
          "expression": "ROUND(SUM(`sum_ratings`) / NULLIF(SUM(`explicit_ratings`), 0), 2)"
        }
      ]
    },
    {
      "name": "users_funnel",
      "displayName": "Silver Users",
      "queryLines": [
        "SELECT\n",
        "  `user_id`,\n",
        "  CASE\n",
        "    WHEN lower(trim(`country`)) = 'usa' THEN 'United States of America'\n",
        "    ELSE INITCAP(`country`)\n",
        "  END AS country,\n",
        "  CAST(`age` AS INT) AS age,\n",
        "  CAST(FLOOR(`age` / 10) * 10 AS INT) AS age_bin\n",
        "FROM\n",
        "  silver.users"
      ]
    },
    {
      "name": "ratings_funnel",
      "displayName": "Layer Counts",
      "queryLines": [
        "SELECT\n",
        "  'Books' AS stream,\n",
        "  '1 · Bronze' AS layer,\n",
        "  COUNT(*) AS row_count\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      TRY_CAST(`Year-Of-Publication` AS INT) AS year_of_publication\n",
        "    FROM\n",
        "      bronze.books_raw\n",
        "  ) t\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Books',\n",
        "  '2 · Silver',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      `year_of_publication`\n",
        "    FROM\n",
        "      silver.books\n",
        "  ) t\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Books',\n",
        "  '3 · Quarantined (silver)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      TRY_CAST(`year_of_publication` AS INT) AS year_of_publication\n",
        "    FROM\n",
        "      silver.books_invalid\n",
        "  ) t\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Books',\n",
        "  '4 · Gold',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      `year_of_publication`\n",
        "    FROM\n",
        "      gold.books_rating_stats\n",
        "  ) t\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      t.year_of_publication IS NOT NULL\n",
        "      AND t.year_of_publication <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Ratings',\n",
        "  '1 · Bronze',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  bronze.ratings_raw `r`\n",
        "    LEFT JOIN (\n",
        "      SELECT\n",
        "        `ISBN` AS isbn,\n",
        "        TRY_CAST(`Year-Of-Publication` AS INT) AS year_of_publication\n",
        "      FROM\n",
        "        bronze.books_raw\n",
        "    ) `b`\n",
        "      ON `b`.`isbn` = `r`.`ISBN`\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      `b`.`year_of_publication` IS NOT NULL\n",
        "      AND `b`.`year_of_publication` >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      `b`.`year_of_publication` IS NOT NULL\n",
        "      AND `b`.`year_of_publication` <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Ratings',\n",
        "  '2 · Silver',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  silver.ratings `r`\n",
        "    LEFT JOIN silver.books `b`\n",
        "      ON `b`.`isbn` = `r`.`isbn`\n",
        "WHERE\n",
        "  (\n",
        "    :pub_year_range.min IS NULL\n",
        "    OR (\n",
        "      `b`.`year_of_publication` IS NOT NULL\n",
        "      AND `b`.`year_of_publication` >= YEAR(:pub_year_range.min)\n",
        "    )\n",
        "  )\n",
        "  AND (\n",
        "    :pub_year_range.max IS NULL\n",
        "    OR (\n",
        "      `b`.`year_of_publication` IS NOT NULL\n",
        "      AND `b`.`year_of_publication` <= YEAR(:pub_year_range.max)\n",
        "    )\n",
        "  )\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Ratings',\n",
        "  '3 · Quarantined (silver)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  silver.ratings_invalid\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Users',\n",
        "  '1 · Bronze',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  bronze.users_raw\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Users',\n",
        "  '2 · Silver',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  silver.users\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Users',\n",
        "  '3 · Quarantined (silver)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  silver.users_invalid"
      ],
      "parameters": [
        {
          "displayName": "Publication Year Range",
          "keyword": "pub_year_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "1995-01-01"
              },
              "max": {
                "value": "2004-12-31"
              }
            }
          }
        }
      ]
    },
    {
      "name": "active_users",
      "displayName": "Top Users by Activity",
      "queryLines": [
        "WITH user_stats AS (\n",
        "  SELECT\n",
        "    `r`.`user_id` AS user_id,\n",
        "    MAX(\n",
        "      CASE\n",
        "        WHEN lower(trim(`u`.`country`)) = 'usa' THEN 'United States of America'\n",
        "        ELSE INITCAP(`u`.`country`)\n",
        "      END\n",
        "    ) AS country,\n",
        "    MAX(CAST(`u`.`age` AS INT)) AS age,\n",
        "    COUNT_IF(`r`.`book_rating` > 0) AS explicit_count,\n",
        "    COUNT(*) AS rating_count\n",
        "  FROM\n",
        "    silver.ratings `r`\n",
        "      LEFT JOIN silver.users `u`\n",
        "        ON `u`.`user_id` = TRY_CAST(`r`.`user_id` AS STRING)\n",
        "  GROUP BY\n",
        "    `r`.`user_id`\n",
        ")\n",
        "(\n",
        "  SELECT\n",
        "    'Active (Explicit)' AS list_type,\n",
        "    ROW_NUMBER() OVER (ORDER BY explicit_count DESC, user_id) AS user_rank,\n",
        "    user_id,\n",
        "    country,\n",
        "    age,\n",
        "    explicit_count,\n",
        "    rating_count\n",
        "  FROM\n",
        "    user_stats\n",
        "  ORDER BY\n",
        "    explicit_count DESC,\n",
        "    user_id\n",
        "  LIMIT 10\n",
        ")\n",
        "UNION ALL\n",
        "(\n",
        "  SELECT\n",
        "    'Buyers (All Ratings)' AS list_type,\n",
        "    ROW_NUMBER() OVER (ORDER BY rating_count DESC, user_id) AS user_rank,\n",
        "    user_id,\n",
        "    country,\n",
        "    age,\n",
        "    explicit_count,\n",
        "    rating_count\n",
        "  FROM\n",
        "    user_stats\n",
        "  ORDER BY\n",
        "    rating_count DESC,\n",
        "    user_id\n",
        "  LIMIT 10\n",
        ")\n",
        "ORDER BY\n",
        "  list_type,\n",
        "  user_rank"
      ]
    }
  ],
